@page "/AdjustHoldings"

@rendermode InteractiveServer
@inject IDbContextFactory<FinanceContext> DbContextFactory


<h3>AdjustHoldings</h3>
<p class="subtitle">Add or remove holdings</p>

Symbol | Shares | Cost 

<div class="add-form">
    <input @bind="newSymbol" placeholder="Symbol" />
    <input type="number" step="0.0001" @bind="newShares" placeholder="Shares" />
    <input type="number" step="0.01" @bind="newPrice" placeholder="Purchase price" />
    <button class="btn btn-primary" @onclick="AddHolding" disabled="@isBusy">Add</button>

</div>


Symbol to add on to | Additional Shares | Cost of new shares


<div class="add-form">
    <input @bind="addtoSymbol" placeholder="Symbol" />
    <input type="number" step="0.0001" @bind="addtoShares" placeholder="Shares" />
    <input type="number" step="0.01" @bind="addtoPrice" placeholder="Purchase price" />
    <button class="btn btn-primary" @onclick="ButtonClickAddtoHolding" disabled="@isBusy">Add in addition to</button>

</div>

Symbol to add on to | Additional Shares | Cost of new shares


<div class="add-form">
    <input @bind="removesymbol" placeholder="Symbol" />
    <button class="btn btn-primary" @onclick="ButtonClickRemoveHolding" disabled="@isBusy">Remove Holding</button>

</div>

@if (message is not null)
{
    <p class="message">@message</p>
}


@if (pageholdings is null)
{
    <p><em>Loading holdings…</em></p>
}
else if (pageholdings.Count == 0)
{
    <p>No holdings yet.</p>
}
else
{
    <table class="holdings">
        <thead>
            <tr>
                <th>Symbol</th>
                <th class="num">Shares</th>
                <th class="num">Avg Cost</th>
                <th class="num">Current</th>
                <th class="num">Market Value</th>
                <th class="num">Gain / Loss</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var holding in pageholdings)
            {
                decimal? value = holding.CurrentPrice * holding.Shares;
                decimal? gain = value - (holding.AvgPurchasePrice * holding.Shares);

                <tr>
                    <td class="symbol">@holding.Symbol</td>
                    <td class="num">@holding.Shares.ToString("0.####")</td>
                    <td class="num">@holding.AvgPurchasePrice.ToString("C2")</td>
                    <td class="num">@(holding.CurrentPrice?.ToString("C2") ?? "—")</td>
                    <td class="num">@(value?.ToString("C2") ?? "—")</td>
                    <td class="num @GainClass(gain)">@(gain?.ToString("C2") ?? "—")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4">Total</td>
                <td class="num">@total.ToString("C2")</td>
                <td class="num @GainClass(totalgainloss)">@totalgainloss.ToString("C2" ?? "-")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
}


@code {

    private string newSymbol = "";
    private decimal newShares;
    private decimal newPrice;
    private string? message;
    private bool isBusy;
    private List<Holding>? pageholdings;
    private decimal total;
    private decimal totalgainloss;
    private string addtoSymbol = "";
    private decimal addtoShares;
    private decimal addtoPrice;
    private string removesymbol;

    private static string GainClass(decimal? gain) =>
    gain is null ? "" : gain >= 0 ? "gain" : "loss";

    protected override async Task OnInitializedAsync()
    {
        await LoadHoldings();
    }

    private async Task LoadHoldings()
    {
        using var context = await DbContextFactory.CreateDbContextAsync();
        pageholdings = await Holding.GetHoldingsWithPrices(context);

        total = pageholdings.Sum(h => (h.CurrentPrice ?? 0) * h.Shares);
        totalgainloss = pageholdings.Sum(h => ((h.CurrentPrice ?? 0) - h.AvgPurchasePrice) * h.Shares);
    }


    private async Task AddHolding()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(newSymbol))
        {
            message = "Enter a symbol.";
            return;
        }

        isBusy = true;
        try
        {
            var context = await DbContextFactory.CreateDbContextAsync();
            var holding = new Holding { Symbol = newSymbol.ToUpperInvariant() };

            if (await holding.CreateHolding(context, newSymbol, newShares, newPrice))
            {
                message = $"Added {newSymbol.ToUpperInvariant()}.";
                newSymbol = "";
                newShares = 0;
                newPrice = 0;
                await LoadHoldings();
            }
            else
            {
                message = "Could not add — unknown symbol, already held, or non-positive values.";
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    string test = "test";

    private async Task ButtonClickAddtoHolding()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(addtoSymbol))
        {
            message = "Enter a symbol.";
            return;
        }

        isBusy = true;
        try
        {
            var context = await DbContextFactory.CreateDbContextAsync();

            if (Holding.AddtoHolding(context, addtoSymbol, addtoShares, addtoPrice))
            {
                message = $"Added to {addtoSymbol.ToUpperInvariant()}.";
                addtoSymbol = "";
                addtoShares = 0;
                addtoPrice = 0;
                await LoadHoldings();
            }
            else
            {
                message = "Could not add — Symbol not already held, or non-positive values.";
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ButtonClickRemoveHolding()
    {
        message = null;

        if (string.IsNullOrWhiteSpace(removesymbol))
        {
            message = "Enter a symbol.";
            return;
        }

        isBusy = true;
        try
        {
            var context = await DbContextFactory.CreateDbContextAsync();

            if (Holding.Removeholding(context, removesymbol))
            {
                message = $"Removed {removesymbol.ToUpperInvariant()}.";
                await LoadHoldings();
            }
            else
            {
                message = "Could not remove — Symbol not already held, or non-positive values.";
            }
        }
        finally
        {
            isBusy = false;
        }
    }

}
